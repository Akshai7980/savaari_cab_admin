{
    "formID": "DRIVER_BOOKING_FORM",
    "formTitle": "Add Driver Booking",
    "infoTooltip": "Complete all mandatory fields to enable 'Schedule Booking'.",
    "formSectionConfig": [
        {
            "sectionID": "secBookingDetails",
            "sectionLabel": "Booking Details",
            "sectionLayout": 2,
            "formFieldConfig": [
                {
                    "fieldID": "customerName",
                    "fieldLabel": "Customer Name",
                    "controlType": "TextBox",
                    "type": "text",
                    "colspan": 2,
                    "mandatory": true,
                    "autoCapitalize": true,
                    "placeholder": "Enter Customer Name"
                },
                {
                    "fieldID": "address",
                    "fieldLabel": "Address",
                    "controlType": "TextArea",
                    "colspan": 2,
                    "mandatory": true,
                    "autoCapitalize": true,
                    "showCounter": true,
                    "maxLength": 100,
                    "placeholder": "Enter full address"
                },
                {
                    "fieldID": "dialCode",
                    "fieldLabel": "Dial Code",
                    "controlType": "TextBox",
                    "colspan": 1,
                    "prefixIcon": "🇮🇳",
                    "prefixText": "+ 91 ( Indian )",
                    "disable": true
                },
                {
                    "fieldID": "customerNumber",
                    "fieldLabel": "Mobile Number",
                    "controlType": "Number",
                    "colspan": 1,
                    "mandatory": true,
                    "placeholder": "Mobile Number"
                },
                {
                    "fieldID": "pickUpLocation",
                    "fieldLabel": "Pick Up Location",
                    "controlType": "TextBox",
                    "colspan": 1,
                    "mandatory": true,
                    "autoCapitalize": true,
                    "placeholder": "Enter Pick Up Location"
                },
                {
                    "fieldID": "purposeOfTravel",
                    "fieldLabel": "Purpose Of Travel",
                    "controlType": "Dropdown",
                    "colspan": 1,
                    "dataSourceKey": "lov-data/driver-booking/purpose-of-travel",
                    "mandatory": true,
                    "placeholder": "Select Purpose"
                },
                {
                    "fieldID": "startDate",
                    "fieldLabel": "Trip Start Date",
                    "controlType": "Date",
                    "colspan": 1,
                    "mandatory": true,
                    "minDate": "CURRENT_DATE",
                    "maxDate": "CURRENT_DATE+15",
                    "defaultValue": "CURRENT_DATE",
                    "placeholder": "mm/dd/yyyy"
                },
                {
                    "fieldID": "endDate",
                    "fieldLabel": "Trip End Date",
                    "controlType": "Date",
                    "colspan": 1,
                    "mandatory": true,
                    "dependsOn": "startDate",
                    "placeholder": "mm/dd/yyyy"
                },
                {
                    "fieldID": "startTime",
                    "fieldLabel": "Trip Start Time",
                    "controlType": "TextBox",
                    "type": "time",
                    "colspan": 1,
                    "mandatory": true,
                    "defaultValue": "CURRENT_TIME+15",
                    "placeholder": "--:-- --"
                },
                {
                    "fieldID": "numberOfDays",
                    "fieldLabel": "Number Of Days",
                    "controlType": "Dropdown",
                    "colspan": 1,
                    "dataSourceKey": "lov-data/driver-booking/number-of-days",
                    "mandatory": true,
                    "defaultValue": "1",
                    "placeholder": "Select Days"
                }
            ]
        },
        {
            "sectionID": "secDriverVehicleDetails",
            "sectionLabel": "Driver & Vehicle Details",
            "sectionLayout": 2,
            "formFieldConfig": [
                {
                    "fieldID": "requiredDriver",
                    "fieldLabel": "Required Driver",
                    "controlType": "TextBox",
                    "colspan": 1,
                    "mandatory": true,
                    "readonly": true,
                    "autoCapitalize": true,
                    "placeholder": "Select Driver"
                },
                {
                    "fieldID": "rejectedDriver",
                    "fieldLabel": "Rejected Driver",
                    "controlType": "TextBox",
                    "colspan": 1,
                    "autoCapitalize": true,
                    "placeholder": "Enter Rejected Driver"
                },
                {
                    "fieldID": "cusVehicleBrand",
                    "fieldLabel": "Customer Vehicle Brand",
                    "controlType": "Dropdown",
                    "colspan": 1,
                    "dataSourceKey": "lov-data/driver-booking/vehicle-brands",
                    "mandatory": true,
                    "placeholder": "Select Brand"
                },
                {
                    "fieldID": "cusVehicleModel",
                    "fieldLabel": "Customer Vehicle Model",
                    "controlType": "Dropdown",
                    "colspan": 1,
                    "dependsOn": "cusVehicleBrand",
                    "dataSourceKey": "lov-data/driver-booking/vehicle-models",
                    "placeholder": "Select Model",
                    "mandatory": true,
                    "options": [
                        {
                            "label": "Select Model",
                            "value": ""
                        }
                    ]
                },
                {
                    "fieldID": "cusVehicleType",
                    "fieldLabel": "Customer Vehicle Type",
                    "controlType": "Dropdown",
                    "colspan": 1,
                    "dataSourceKey": "lov-data/driver-booking/vehicle-types",
                    "mandatory": true,
                    "placeholder": "Select Type"
                },
                {
                    "fieldID": "cusVehicleNumber",
                    "fieldLabel": "Customer Vehicle Number",
                    "controlType": "TextBox",
                    "colspan": 1,
                    "mandatory": true,
                    "formatType": "VehicleNumber",
                    "hint": "Format: XX 00 XX 0000 (e.g., KL 04 BA 0405)",
                    "placeholder": "e.g., KL 04 BA 0405"
                }
            ]
        }
    ]
}