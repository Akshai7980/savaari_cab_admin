{
    "formID": "DRIVER_BOOKING_FORM",
    "formTitle": "Add Driver Booking",
    "infoTooltip": "Complete all mandatory fields to enable 'Schedule Booking'.",
    "formSectionConfig": [
        {
            "sectionID": "secBookingDetails",
            "sectionLabel": "Booking Details",
            "sectionLayout": 2,
            "formFieldConfig": [
                {
                    "fieldID": "customerName",
                    "fieldLabel": "Customer Name",
                    "controlType": "TextBox",
                    "type": "text",
                    "colspan": 2,
                    "mandatory": true,
                    "autoCapitalize": true
                },
                {
                    "fieldID": "address",
                    "fieldLabel": "Address",
                    "controlType": "TextArea",
                    "colspan": 2,
                    "mandatory": true,
                    "autoCapitalize": true,
                    "showCounter": true,
                    "maxLength": 100
                },
                {
                    "fieldID": "dialCode",
                    "fieldLabel": "Dial Code",
                    "controlType": "TextBox",
                    "colspan": 1,
                    "prefixIcon": "🇮🇳",
                    "prefixText": "+ 91",
                    "disable": true
                },
                {
                    "fieldID": "customerNumber",
                    "fieldLabel": "Mobile Number",
                    "controlType": "Number",
                    "colspan": 1,
                    "mandatory": true
                },
                {
                    "fieldID": "pickUpLocation",
                    "fieldLabel": "Pick Up Location",
                    "controlType": "TextBox",
                    "colspan": 1,
                    "mandatory": true,
                    "autoCapitalize": true
                },
                {
                    "fieldID": "purposeOfTravel",
                    "fieldLabel": "Purpose Of Travel",
                    "controlType": "Dropdown",
                    "colspan": 1,
                    "options": [
                        {
                            "label": "Select Purpose",
                            "value": ""
                        },
                        {
                            "label": "Business",
                            "value": "Business"
                        },
                        {
                            "label": "Vacation",
                            "value": "Vacation"
                        },
                        {
                            "label": "Family Visit",
                            "value": "Family Visit"
                        },
                        {
                            "label": "Medical",
                            "value": "Medical"
                        },
                        {
                            "label": "Education",
                            "value": "Education"
                        },
                        {
                            "label": "Pilgrimage",
                            "value": "Pilgrimage"
                        },
                        {
                            "label": "Shopping",
                            "value": "Shopping"
                        },
                        {
                            "label": "Event/Wedding",
                            "value": "Event/Wedding"
                        },
                        {
                            "label": "Solo Trip",
                            "value": "Solo Trip"
                        },
                        {
                            "label": "Relocation",
                            "value": "Relocation"
                        },
                        {
                            "label": "Other",
                            "value": "Other"
                        }
                    ],
                    "mandatory": true
                },
                {
                    "fieldID": "startDate",
                    "fieldLabel": "Trip Start Date",
                    "controlType": "Date",
                    "colspan": 1,
                    "mandatory": true
                },
                {
                    "fieldID": "endDate",
                    "fieldLabel": "Trip End Date",
                    "controlType": "Date",
                    "colspan": 1,
                    "mandatory": true
                },
                {
                    "fieldID": "startTime",
                    "fieldLabel": "Trip Start Time",
                    "controlType": "TextBox",
                    "type": "time",
                    "colspan": 1,
                    "mandatory": true
                },
                {
                    "fieldID": "numberOfDays",
                    "fieldLabel": "Number Of Days",
                    "controlType": "Dropdown",
                    "colspan": 1,
                    "options": [
                        {
                            "label": "Select Days",
                            "value": ""
                        },
                        {
                            "label": "0",
                            "value": 0
                        },
                        {
                            "label": "1",
                            "value": 1
                        },
                        {
                            "label": "2",
                            "value": 2
                        },
                        {
                            "label": "3",
                            "value": 3
                        },
                        {
                            "label": "4",
                            "value": 4
                        },
                        {
                            "label": "5",
                            "value": 5
                        },
                        {
                            "label": "6",
                            "value": 6
                        },
                        {
                            "label": "7",
                            "value": 7
                        },
                        {
                            "label": "8",
                            "value": 8
                        },
                        {
                            "label": "9",
                            "value": 9
                        },
                        {
                            "label": "10",
                            "value": 10
                        }
                    ],
                    "mandatory": true
                }
            ]
        },
        {
            "sectionID": "secDriverVehicleDetails",
            "sectionLabel": "Driver & Vehicle Details",
            "sectionLayout": 2,
            "formFieldConfig": [
                {
                    "fieldID": "requiredDriver",
                    "fieldLabel": "Required Driver",
                    "controlType": "TextBox",
                    "colspan": 1,
                    "mandatory": true,
                    "autoCapitalize": true
                },
                {
                    "fieldID": "rejectedDriver",
                    "fieldLabel": "Rejected Driver",
                    "controlType": "TextBox",
                    "colspan": 1,
                    "autoCapitalize": true
                },
                {
                    "fieldID": "cusVehicleBrand",
                    "fieldLabel": "Customer Vehicle Brand",
                    "controlType": "Dropdown",
                    "colspan": 1,
                    "dataSourceKey": "lov-data/driver-booking/vehicle-brands",
                    "mandatory": true
                },
                {
                    "fieldID": "cusVehicleModel",
                    "fieldLabel": "Customer Vehicle Model",
                    "controlType": "Dropdown",
                    "colspan": 1,
                    "dependsOn": "cusVehicleBrand",
                    "dataSourceKey": "lov-data/driver-booking/vehicle-models",
                    "placeholder": "Select Model",
                    "mandatory": true,
                    "options": [
                        {
                            "label": "Select Model",
                            "value": ""
                        }
                    ]
                },
                {
                    "fieldID": "cusVehicleType",
                    "fieldLabel": "Customer Vehicle Type",
                    "controlType": "Dropdown",
                    "colspan": 1,
                    "dataSourceKey": "lov-data/driver-booking/vehicle-types",
                    "mandatory": true
                },
                {
                    "fieldID": "cusVehicleNumber",
                    "fieldLabel": "Customer Vehicle Number",
                    "controlType": "TextBox",
                    "colspan": 1,
                    "mandatory": true,
                    "formatType": "VehicleNumber",
                    "hint": "Format: XX 00 XX 0000 (e.g., KL 04 BA 0405)"
                }
            ]
        }
    ]
}