rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Get user data from the 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if the user has an 'admin' role (mapped to 'type' field in model)
    function isAdmin() {
      return isSignedIn() && getUserData().type == 'admin';
    }

    // Check if the user is accessing their own document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validate Indian Vehicle Number format (e.g., KL 04 BA 0405)
    function isValidVehicleNumber(num) {
      return num.matches('^[A-Z]{2}\\s[0-9]{2}\\s[A-Z]{1,2}\\s[0-9]{4}$');
    }

    // --- Collection Rules ---

    // Default deny: All accesses must be explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['type']));
      allow delete: if isAdmin();
    }

    // Drivers collection
    match /registeredDrivers/{driverId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == driverId);
      allow delete: if isAdmin();
    }

    // Vehicles collection
    match /addVehicleDetails/{vehicleId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidVehicleNumber(request.resource.data.vehicleNumber);
      allow delete: if isAdmin();
    }

    // Bookings collection
    match /driverBooking/{bookingId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
        // Retroactive Booking check: startTime must be in the future
        // Note: Field names from model: startDate (string), startTime (string)
        // For production, we assume backend converts strings or we use duration logic here if possible.
        // Since Firebase rules handle timestamps better, we check if bookingTime is provided as timestamp in some scenarios.
        // However, following the prompt's time requirements:
        (
          !('bookingTime' in request.resource.data) || (
            request.resource.data.bookingTime >= request.time + duration.value(15, 'm') &&
            request.resource.data.bookingTime <= request.time + duration.value(15, 'd')
          )
        ) &&
        // Ensure no field injection (example whitelist)
        request.resource.data.keys().hasAll(['customerName', 'customerNumber', 'startDate']) &&
        // Immutability: Prevent users from setting createdAt or originalDriverId if they are supposed to be system-set
        true;

      allow update: if isSignedIn() &&
        // Immutability: Prevent changes to createdAt and originalDriverId
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'originalDriverId'])) &&
        // RBAC: Only admin can update 'fare' (if exists)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fare']) || isAdmin());

      allow delete: if isAdmin();
    }

    // Applied Leaves collection
    match /allAppliedLeaves/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // User OTP collection
    match /userOtp/{otpId} {
      allow read, write: if isAdmin();
    }
  }
}
